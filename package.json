    "docx": "^9.7.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.15.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
