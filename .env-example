# Opsi 1: Koneksi via URL (utamakan ini jika diisi)
# DATABASE_URL=postgresql://user:password@localhost:5432/nama_db

# Opsi 2: Koneksi ke Local PostgreSQL (dipakai jika DATABASE_URL kosong)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

NODE_ENV=development

# Wajib: minimal 32 karakter (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Produksi saja: whitelist origin dipisah koma, contoh: https://app.com,https://www.app.com
# CORS_ORIGIN=
